# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). Never commit .env.local.
#
# The project URL and publishable (anon) key are safe to expose to the browser
# because Row Level Security protects the data. Push-only secrets below stay on the server.
# Never put the service-role / secret key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Push: the public VAPID key is safe for the browser. The remaining values are server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Separate random 32-byte hex capability for the reminder worker, NOT a Supabase key.
PUSH_WORKER_SECRET=
