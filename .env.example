# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). Never commit .env.local.
#
# Only the project URL and the publishable (anon) key belong here. They are
# safe to expose to the browser because Row Level Security protects the data.
# Never put the service-role / secret key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
